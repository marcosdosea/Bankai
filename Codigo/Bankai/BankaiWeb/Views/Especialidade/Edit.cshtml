@model BankaiWeb.Models.EspecialidadeViewModel

@{
    ViewData["Title"] = "Editar Especialidade";
}

<div class="manage-container" style="grid-template-columns: 1fr; max-width: 600px;">
    <div class="bankai-card">
        <h3 class="section-title"><span>✏️</span> Editar Especialidade</h3>
        <p class="text-muted mb-4">Altere o nome da especialidade selecionada.</p>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-4">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index" class="btn-view-profile">← Voltar para a lista</a>
                <button type="submit" class="btn-bankai">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}