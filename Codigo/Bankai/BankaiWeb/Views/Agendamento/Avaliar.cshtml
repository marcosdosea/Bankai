@model BankaiWeb.Models.AgendamentoViewModel

@{
    ViewData["Title"] = "Avaliar";
}

<h1>Avaliar agendamento</h1>

<form asp-action="Avaliar" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-primary mt-3">Avaliar</button>
    <a asp-action="Index">Voltar</a>
</form>