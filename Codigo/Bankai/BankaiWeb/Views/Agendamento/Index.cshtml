@model IEnumerable<Core.DTO.AgendamentoDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdCliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdProfissional)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiaSemana)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HorarioInicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HorarioFim)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DescricaoServico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoCobranca)
            </th>
            <td>
                @Html.DisplayNameFor(model => model.StatusAgendamento)
            </td>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdCliente)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdProfissional)
            </td>
            <td>
                @Html.DisplayFor(model => item.DiaSemana)
            </td>
            <td>
                @Html.DisplayFor(model => item.HorarioInicio)
            </td>
            <td>
                @Html.DisplayFor(model => item.HorarioFim)
            </td>
            <td>
                @Html.DisplayFor(model => item.DescricaoServico)
            </td>
            <td>
                @Html.DisplayFor(model => item.TipoCobranca)
            </td>
            <td>
                @Html.DisplayFor(model => item.StatusAgendamento)
            </td>
            <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
            </td>
        </tr>
}
    </tbody>
</table>
