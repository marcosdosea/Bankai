@model BankaiWeb.Models.AgendamentoViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>AgendamentoViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="IdCliente" class="control-label"></label>
                <input asp-for="IdCliente" class="form-control" />
                <span asp-validation-for="IdCliente" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdProfissional" class="control-label"></label>
                <input asp-for="IdProfissional" class="form-control" />
                <span asp-validation-for="IdProfissional" class="text-danger"></span>
            </div>

            <div class="form-group">
                <select asp-for="DiaSemana" class="form-control">
                    <option value="D">Domingo</option>
                    <option value="SF">Segunda</option>
                    <option value="TF">Terça</option>
                    <option value="QF">Quarta</option>
                    <option value="QIF">Quinta</option>
                    <option value="SXF">Sexta</option>
                    <option value="S">Sábado</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="HorarioInicio" class="control-label"></label>
                <input asp-for="HorarioInicio" class="form-control" />
                <span asp-validation-for="HorarioInicio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HorarioFim" class="control-label"></label>
                <input asp-for="HorarioFim" class="form-control" />
                <span asp-validation-for="HorarioFim" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DescricaoServico" class="control-label"></label>
                <input asp-for="DescricaoServico" class="form-control" />
                <span asp-validation-for="DescricaoServico" class="text-danger"></span>
            </div>

            <div class="form-group">
                <select asp-for="TipoCobranca" class="form-control">
                    <option value="F">Fixo</option>
                    <option value="O">Orçamento</option>
                </select>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
