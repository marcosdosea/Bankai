@model BankaiWeb.Models.AgendamentoViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>AgendamentoViewModel</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IdCliente)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdCliente)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IdProfissional)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdProfissional)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DiaSemana)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DiaSemana)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.HorarioInicio)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.HorarioInicio)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.HorarioFim)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.HorarioFim)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DescricaoServico)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DescricaoServico)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TipoCobranca)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoCobranca)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nota)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nota)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Comentario)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Comentario)
        </dd>
    </dl>
</div>

<hr />
<h4>Avaliar agendamento</h4>
<form asp-action="Avaliar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Nota" class="control-label"></label>
        <select asp-for="Nota" class="form-control">
            <option value="">Selecione uma nota</option>
            <option value="MR">Muito ruim</option>
            <option value="R">Ruim</option>
            <option value="B">Bom</option>
            <option value="MB">Muito bom</option>
            <option value="E">Excelente</option>
        </select>
        <span asp-validation-for="Nota" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Comentario" class="control-label"></label>
        <textarea asp-for="Comentario" class="form-control"></textarea>
        <span asp-validation-for="Comentario" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Avaliar</button>
</form>

<div>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
