@model BankaiWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = "Excluir Conta";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h4 class="text-danger fw-bold mb-2">Excluir Conta</h4>
                <p class="text-muted mb-4">Tem certeza que deseja excluir permanentemente este registro? Esta ação não poderá ser desfeita.</p>

                <dl class="row bg-light rounded-3 p-3 mb-4">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nome)</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Nome</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CpfCnpj)</dt>
                    <dd class="col-sm-8">@Model.CpfCnpj</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Perfil</dt>
                    <dd class="col-sm-8">@(Model.EhProfissional ? "Profissional" : "Cliente")</dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-danger fw-bold px-4">Confirmar Exclusão</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>