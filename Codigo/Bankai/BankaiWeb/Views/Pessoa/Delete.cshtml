@model BankaiWEB.Models.PessoaViewModel

@{
    ViewData["Title"] = "Excluir Pessoa";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-secondary font-weight-bold">
        <i class="bi bi-arrow-left"></i> Voltar para a lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bankai-card border-danger">
            <div class="text-center mb-4">
                <div class="d-inline-block p-3 rounded-circle bg-danger-subtle text-danger mb-2" style="font-size: 2rem;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 class="font-weight-bold text-danger">Confirmar Exclusão</h3>
                <p class="text-muted">Tem certeza de que deseja remover este cadastro permanentemente?</p>
            </div>

            <div class="bg-light p-4 rounded-3 mb-4">
                <div class="row mb-2">
                    <div class="col-sm-4 text-muted small fw-bold">NOME</div>
                    <div class="col-sm-8 fw-bold">@Model.Nome</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 text-muted small fw-bold">CPF/CNPJ</div>
                    <div class="col-sm-8">@Model.Cpfcnpj</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 text-muted small fw-bold">EMAIL</div>
                    <div class="col-sm-8">@Model.Email</div>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Codigo" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger flex-grow-1 py-3 font-weight-bold">Sim, Excluir</button>
                    <a asp-action="Index" class="btn btn-outline-secondary py-3 px-4 rounded-3">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>