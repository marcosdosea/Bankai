@model BankaiWEB.Models.PessoaViewModel

@{
    ViewData["Title"] = "Editar Pessoa";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-secondary font-weight-bold">
        <i class="bi bi-arrow-left"></i> Voltar para a lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bankai-card">
            <h3 class="text-center font-weight-bold mb-4">Editar Cadastro</h3>

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Codigo" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label text-muted small fw-bold">NOME COMPLETO</label>
                        <div class="input-group bankai-input-group">
                            <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                            <input asp-for="Nome" class="form-control" />
                        </div>
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Cpfcnpj" class="form-label text-muted small fw-bold">CPF/CNPJ</label>
                        <div class="input-group bankai-input-group">
                            <span class="input-group-text"><i class="bi bi-fingerprint"></i></span>
                            <input asp-for="Cpfcnpj" class="form-control" />
                        </div>
                        <span asp-validation-for="Cpfcnpj" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="Email" class="form-label text-muted small fw-bold">EMAIL</label>
                        <div class="input-group bankai-input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" type="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-check form-switch mb-4 mt-2">
                    <input class="form-check-input" type="checkbox" asp-for="Isprofessional" id="chkProf">
                    <label class="form-check-label fw-bold text-muted" for="chkProf">Perfil Profissional (Quero Trabalhar)</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-bankai flex-grow-1 py-3">Salvar Alterações</button>
                    <a asp-action="Index" class="btn btn-outline-secondary py-3 px-4 rounded-3">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}