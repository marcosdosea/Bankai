@model BankaiWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = "Detalhes da Pessoa";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-secondary font-weight-bold">
        <i class="bi bi-arrow-left"></i> Voltar para a lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bankai-card">
            <div class="text-center mb-4">
                <div class="d-inline-block p-3 rounded-circle bg-light text-warning mb-2" style="font-size: 2rem;">
                    <i class="bi bi-person-fill"></i>
                </div>
                <h3 class="font-weight-bold">@Model.Nome</h3>
                <span class="badge @(Model.EhProfissional ? "bg-warning text-dark" : "bg-secondary")">
                    @(Model.EhProfissional ? "Profissional" : "Cliente")
                </span>
            </div>

            <div class="bg-light p-4 rounded-3 mb-4">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted small fw-bold">CÓDIGO</div>
                    <div class="col-sm-8 fw-bold">#@Model.id</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted small fw-bold">CPF/CNPJ</div>
                    <div class="col-sm-8">@Model.CpfCnpj</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 text-muted small fw-bold">EMAIL</div>
                    <div class="col-sm-8">@Model.Email</div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.id" class="btn btn-bankai flex-grow-1 py-2">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary py-2 px-4 rounded-3">Voltar</a>
            </div>
        </div>
    </div>
</div>