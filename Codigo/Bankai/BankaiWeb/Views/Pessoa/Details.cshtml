@model BankaiWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = "Detalhes da Pessoa";
}

<h1>Detalhes da Pessoa</h1>

<div>
    <h4>PessoaViewModel</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
