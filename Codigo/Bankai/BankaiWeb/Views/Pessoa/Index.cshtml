@model IEnumerable<BankaiWeb.Models.PessoaViewModel>

@{
    ViewData["Title"] = "Pessoas Cadastradas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Pessoas Cadastradas</h2>
            <p class="text-muted mb-0">Gerencie clientes e profissionais da plataforma Bankai</p>
        </div>
        <a asp-action="Create" class="btn text-white fw-semibold px-4" style="background-color: #D97706;">
            + Nova Conta
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Nome)</th>
                            <th>@Html.DisplayNameFor(model => model.CpfCnpj)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.Telefone)</th>
                            <th>Perfil</th>
                            <th>@Html.DisplayNameFor(model => model.Saldo)</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Nome</td>
                                <td>@item.CpfCnpj</td>
                                <td>@item.Email</td>
                                <td>@item.Telefone</td>
                                <td>
                                    @if (item.EhProfissional)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                            Profissional
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">
                                            Cliente
                                        </span>
                                    }
                                </td>
                                <td class="fw-semibold text-success">@item.Saldo.ToString("C")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Perfil</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning text-dark">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>