@model BankaiWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = "Criar Conta";
}

<div class="container py-5">
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-secondary fw-semibold">
            ← Voltar à Lista
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow border-0 rounded-4 p-4">
                <div class="card-body">
                    <h2 class="text-center fw-bold mb-4">Criar Conta</h2>

                    <!-- Seletor de Perfil (Abas do Protótipo) -->
                    <div class="btn-group w-100 mb-4 p-1 bg-light rounded-3" role="group">
                        <button type="button" id="btnCliente" class="btn bg-white shadow-sm fw-bold rounded-3" style="color: #D97706;" onclick="selecionarPerfil(false)">
                            Quero Contratar
                        </button>
                        <button type="button" id="btnProfissional" class="btn text-secondary fw-semibold rounded-3" onclick="selecionarPerfil(true)">
                            Quero Trabalhar
                        </button>
                    </div>

                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="EhProfissional" id="inputEhProfissional" value="false" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Nome" class="form-label text-uppercase small fw-bold text-muted"></label>
                                <input asp-for="Nome" class="form-control bg-light border-0 py-2" placeholder="Ex: João Silva" />
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CpfCnpj" class="form-label text-uppercase small fw-bold text-muted" id="labelCpfCnpj">CPF</label>
                                <input asp-for="CpfCnpj" class="form-control bg-light border-0 py-2" id="inputCpfCnpj" placeholder="000.000.000-00" />
                                <span asp-validation-for="CpfCnpj" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label text-uppercase small fw-bold text-muted"></label>
                                <input asp-for="Email" class="form-control bg-light border-0 py-2" placeholder="nome@provedor.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Telefone" class="form-label text-uppercase small fw-bold text-muted"></label>
                                <input asp-for="Telefone" class="form-control bg-light border-0 py-2" placeholder="79999999999" />
                                <span asp-validation-for="Telefone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Cep" class="form-label text-uppercase small fw-bold text-muted"></label>
                                <input asp-for="Cep" class="form-control bg-light border-0 py-2" placeholder="49000000" />
                                <span asp-validation-for="Cep" class="text-danger small"></span>
                            </div>

                            <!-- Campos Exclusivos do Profissional (Ocultos na aba Cliente) -->
                            <div class="col-md-6 campo-profissional d-none">
                                <label asp-for="IdEspecialidade" class="form-label text-uppercase small fw-bold text-muted"></label>
                                <select asp-for="IdEspecialidade" asp-items="ViewBag.Especialidades" class="form-select bg-light border-0 py-2">
                                    <option value="">Selecione...</option>
                                </select>
                                <span asp-validation-for="IdEspecialidade" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 campo-profissional d-none">
                                <label asp-for="ArquivoRegistroTecnico" class="form-label text-uppercase small fw-bold text-muted">Registro Técnico (Anexo)</label>
                                <input asp-for="ArquivoRegistroTecnico" type="file" class="form-control bg-light border-0 py-2" accept=".pdf,.jpg,.jpeg,.png" />
                                <span asp-validation-for="ArquivoRegistroTecnico" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn text-white fw-bold py-2 rounded-3" style="background-color: #D97706;">
                                Finalizar Cadastro
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function selecionarPerfil(ehProfissional) {
            document.getElementById('inputEhProfissional').value = ehProfissional;
            const btnCliente = document.getElementById('btnCliente');
            const btnProfissional = document.getElementById('btnProfissional');
            const camposProf = document.querySelectorAll('.campo-profissional');
            const labelCpf = document.getElementById('labelCpfCnpj');
            const inputCpf = document.getElementById('inputCpfCnpj');

            if (ehProfissional) {
                btnProfissional.classList.add('bg-white', 'shadow-sm', 'fw-bold');
                btnProfissional.style.color = '#D97706';
                btnCliente.classList.remove('bg-white', 'shadow-sm', 'fw-bold');
                btnCliente.style.color = '';

                camposProf.forEach(el => el.classList.remove('d-none'));
                labelCpf.innerText = 'CPF/CNPJ';
                inputCpf.placeholder = '00.000.000/0001-00';
            } else {
                btnCliente.classList.add('bg-white', 'shadow-sm', 'fw-bold');
                btnCliente.style.color = '#D97706';
                btnProfissional.classList.remove('bg-white', 'shadow-sm', 'fw-bold');
                btnProfissional.style.color = '';

                camposProf.forEach(el => el.classList.add('d-none'));
                labelCpf.innerText = 'CPF';
                inputCpf.placeholder = '000.000.000-00';
            }
        }
    </script>
}