@model BankaiWeb.Models.ServicoViewModel

@{
    ViewData["Title"] = "Novo Serviço";
}

<div class="manage-container" style="grid-template-columns: 1fr; max-width: 650px; margin: 2rem auto;">
    <div class="bankai-card">
        <h3 class="section-title"><span>➕</span> Cadastrar Novo Serviço</h3>
        <p class="text-muted mb-4">Adicione um novo serviço padronizado ao catálogo geral da plataforma.</p>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" placeholder="Ex: Substituição de Disjuntor no Quadro Geral" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Descricao"></label>
                <textarea asp-for="Descricao" rows="4" style="background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.75rem 1rem; color: var(--text-main); outline: none; font-size: 0.9rem;" placeholder="Ex: Incluso desligamento seguro do barramento geral, remoção do disjuntor avariado e fixação técnica."></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
                <a asp-action="Index" class="btn-view-profile">← Voltar para o catálogo</a>
                <button type="submit" class="btn-bankai">Salvar Serviço</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
