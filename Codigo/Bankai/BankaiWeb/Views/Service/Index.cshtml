@model IEnumerable<BankaiWeb.Models.ServicoViewModel>

@{
    ViewData["Title"] = "Catálogo de Serviços";
    var lista = Model ?? Enumerable.Empty<BankaiWeb.Models.ServicoViewModel>();
}

<div class="manage-container" style="grid-template-columns: 1fr; max-width: 950px; margin: 2rem auto;">
    <div class="main-services-panel bankai-card">
        
        <div class="panel-header-actions mb-3">
            <div>
                <h2 class="section-title m-0"><span>🛠️</span> Catálogo de Serviços Oferecidos</h2>
                <p class="text-muted m-0" style="font-size: 0.85rem;">Gerencie os serviços padronizados disponíveis na plataforma Bankai.</p>
            </div>
            <a asp-action="Create" class="btn-bankai text-decoration-none">
                <span>+</span> Novo Serviço
            </a>
        </div>

        @if (!lista.Any())
        {
            <div class="text-center p-5 text-muted">
                <p class="fs-5">Nenhum serviço cadastrado no catálogo.</p>
                <a asp-action="Create" class="btn-bankai text-decoration-none mt-2">+ Cadastrar Primeiro Serviço</a>
            </div>
        }
        else
        {
            <div class="services-manage-list">
                @foreach (var item in lista)
                {
                    <div class="service-manage-card">
                        <div class="service-meta">
                            <h4>@item.Nome</h4>
                            <p>@item.Descricao</p>
                        </div>

                        <div class="d-flex align-items-center justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-view-profile" title="Ver detalhes completos">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-bankai btn-sm text-decoration-none px-3" style="font-size: 0.85rem;">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir serviço" style="border-radius: var(--radius-sm); font-size: 0.85rem;">✕</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
