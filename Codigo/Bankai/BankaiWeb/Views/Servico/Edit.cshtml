@model BankaiWeb.Models.ServicoViewModel

@{
    ViewData["Title"] = "Editar Serviço";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-secondary fw-bold">
        <i class="bi bi-arrow-left"></i> Voltar para o catálogo
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bankai-card">
            <h3 class="text-center fw-bold mb-2">Editar Serviço</h3>
            <p class="text-center text-muted small mb-4">
                Atualize os dados e a especialidade do serviço selecionado.
            </p>

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="IdEspecialidade" class="form-label text-muted small fw-bold text-uppercase">Especialidade</label>
                    <div class="input-group bankai-input-group">
                        <span class="input-group-text"><i class="bi bi-wrench-adjustable-circle"></i></span>
                        <select asp-for="IdEspecialidade" asp-items="ViewBag.Especialidades" class="form-select">
                            <option value="">Selecione uma especialidade...</option>
                        </select>
                    </div>
                    <span asp-validation-for="IdEspecialidade" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label text-muted small fw-bold text-uppercase">Nome do Serviço</label>
                    <div class="input-group bankai-input-group">
                        <span class="input-group-text"><i class="bi bi-tools"></i></span>
                        <input asp-for="Nome" class="form-control" />
                    </div>
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descricao" class="form-label text-muted small fw-bold text-uppercase">Escopo do Serviço</label>
                    <div class="input-group bankai-input-group">
                        <span class="input-group-text align-items-start pt-2"><i class="bi bi-card-text"></i></span>
                        <textarea asp-for="Descricao" rows="4" class="form-control"></textarea>
                    </div>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-bankai flex-grow-1 py-3 fw-bold">Salvar Alterações</button>
                    <a asp-action="Index" class="btn btn-outline-secondary py-3 px-4 rounded-3">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
