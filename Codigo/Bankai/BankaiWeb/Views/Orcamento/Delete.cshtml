@model BankaiWeb.Models.OrcamentoViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Deletar Orçamento</h1>

<h3>Tem certeza de que deseja excluir isto?</h3>
<div>
    <h4>BankaiWeb.Models.OrcamentoViewModel</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ValorProposto)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ValorProposto)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Validade)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Validade)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MateriaisAdicionais)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MateriaisAdicionais)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar</a>
    </form>
</div>
