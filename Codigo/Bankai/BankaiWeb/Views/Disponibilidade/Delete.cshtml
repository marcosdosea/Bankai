@model BankaiWeb.Models.DisponibilidadeViewModel

@{
    ViewData["Title"] = "Excluir disponibilidade";
    var diaSemana = Model.DiaSemana switch
    {
        "D" => "Domingo",
        "SF" => "Segunda-feira",
        "TF" => "Terça-feira",
        "QF" => "Quarta-feira",
        "QIF" => "Quinta-feira",
        "SXF" => "Sexta-feira",
        "S" => "Sábado",
        _ => Model.DiaSemana
    };
    var status = Model.StatusDisponibilidade == "D" ? "Disponível" : "Não disponível";
}

<div class="mb-4">
    <a asp-action="Index" asp-route-idPessoa="@Model.IdPessoa" class="text-decoration-none text-secondary font-weight-bold">
        <i class="bi bi-arrow-left"></i> Voltar para a lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bankai-card border-danger">
            <div class="text-center mb-4">
                <div class="d-inline-block p-3 rounded-circle bg-danger-subtle text-danger mb-2 fs-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 class="font-weight-bold text-danger">Excluir Disponibilidade</h3>
                <p class="text-muted small">Confirme se deseja remover a disponibilidade deste dia. Esta ação não pode ser desfeita.</p>
            </div>

            <div class="bg-light p-4 rounded-3 mb-4 border">
                <div class="row mb-2">
                    <div class="col-sm-5 text-muted small fw-bold">DIA DA SEMANA</div>
                    <div class="col-sm-7 fw-bold">@diaSemana</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-5 text-muted small fw-bold">HORÁRIOS</div>
                    <div class="col-sm-7">@Model.HorarioInicio?.ToString(@"hh\:mm") até @Model.HorarioFim?.ToString(@"hh\:mm")</div>
                </div>
                <div class="row">
                    <div class="col-sm-5 text-muted small fw-bold">STATUS</div>
                    <div class="col-sm-7">@status</div>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger flex-grow-1 py-3 fw-bold">Confirmar exclusão</button>
                    <a asp-action="Index" asp-route-idPessoa="@Model.IdPessoa" class="btn btn-outline-secondary py-3 px-4 rounded-3">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>