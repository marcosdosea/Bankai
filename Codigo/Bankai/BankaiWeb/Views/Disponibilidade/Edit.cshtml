@model BankaiWeb.Models.DisponibilidadeViewModel

@{
    ViewData["Title"] = "Editar disponibilidade";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h1 class="h2 fw-bold mb-1">Editar disponibilidade</h1>
        <p class="text-muted mb-0">Atualize os horários deste dia.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-3 p-md-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IdPessoa" />

                <div class="mb-3">
                    <label asp-for="DiaSemana" class="form-label"></label>
                    <select asp-for="DiaSemana" class="form-select">
                        <option value="D">Domingo</option>
                        <option value="SF">Segunda-feira</option>
                        <option value="TF">Terça-feira</option>
                        <option value="QF">Quarta-feira</option>
                        <option value="QIF">Quinta-feira</option>
                        <option value="SXF">Sexta-feira</option>
                        <option value="S">Sábado</option>
                    </select>
                    <span asp-validation-for="DiaSemana" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="HorarioInicio" class="form-label"></label>
                        <input asp-for="HorarioInicio" class="form-control" type="time" />
                        <span asp-validation-for="HorarioInicio" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HorarioFim" class="form-label"></label>
                        <input asp-for="HorarioFim" class="form-control" type="time" />
                        <span asp-validation-for="HorarioFim" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4 mt-3">
                    <label asp-for="StatusDisponibilidade" class="form-label"></label>
                    <select asp-for="StatusDisponibilidade" class="form-select">
                        <option value="D">Disponível</option>
                        <option value="ND">Não disponível</option>
                    </select>
                    <span asp-validation-for="StatusDisponibilidade" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a asp-action="Index" asp-route-idPessoa="@Model.IdPessoa" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}