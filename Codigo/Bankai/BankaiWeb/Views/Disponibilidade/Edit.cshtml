@model BankaiWeb.Models.DisponibilidadeViewModel

@{
    ViewData["Title"] = "Editar disponibilidade";
}

<div class="mb-4">
    <a asp-action="Index" asp-route-idPessoa="@Model.IdPessoa" class="text-decoration-none text-secondary font-weight-bold">
        <i class="bi bi-arrow-left"></i> Voltar para a lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bankai-card">
            <h3 class="text-center font-weight-bold mb-2">Editar Disponibilidade</h3>
            <p class="text-center text-muted small mb-4">Atualize os horários e o status deste dia da semana.</p>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IdPessoa" />

                <div class="mb-3">
                    <label asp-for="DiaSemana" class="form-label text-muted small fw-bold">DIA DA SEMANA</label>
                    <div class="input-group bankai-input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-day"></i></span>
                        <select asp-for="DiaSemana" class="form-select">
                            <option value="D">Domingo</option>
                            <option value="SF">Segunda-feira</option>
                            <option value="TF">Terça-feira</option>
                            <option value="QF">Quarta-feira</option>
                            <option value="QIF">Quinta-feira</option>
                            <option value="SXF">Sexta-feira</option>
                            <option value="S">Sábado</option>
                        </select>
                    </div>
                    <span asp-validation-for="DiaSemana" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="HorarioInicio" class="form-label text-muted small fw-bold">HORÁRIO DE INÍCIO</label>
                        <div class="input-group bankai-input-group">
                            <span class="input-group-text"><i class="bi bi-clock"></i></span>
                            <input asp-for="HorarioInicio" class="form-control availability-time" type="time" />
                        </div>
                        <span asp-validation-for="HorarioInicio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="HorarioFim" class="form-label text-muted small fw-bold">HORÁRIO DE TÉRMINO</label>
                        <div class="input-group bankai-input-group">
                            <span class="input-group-text"><i class="bi bi-clock-fill"></i></span>
                            <input asp-for="HorarioFim" class="form-control availability-time" type="time" />
                        </div>
                        <span asp-validation-for="HorarioFim" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="StatusDisponibilidade" class="form-label text-muted small fw-bold">STATUS</label>
                    <div class="input-group bankai-input-group">
                        <span class="input-group-text"><i class="bi bi-toggle-on"></i></span>
                        <select asp-for="StatusDisponibilidade" class="form-select">
                            <option value="D">Disponível</option>
                            <option value="ND">Não disponível</option>
                        </select>
                    </div>
                    <span asp-validation-for="StatusDisponibilidade" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-bankai flex-grow-1 py-3 fw-bold">Salvar alterações</button>
                    <a asp-action="Index" asp-route-idPessoa="@Model.IdPessoa" class="btn btn-outline-secondary py-3 px-4 rounded-3">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}