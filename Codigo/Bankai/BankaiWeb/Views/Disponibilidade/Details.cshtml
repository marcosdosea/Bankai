@model BankaiWeb.Models.DisponibilidadeViewModel

@{
    ViewData["Title"] = "Detalhes da disponibilidade";
    var diaSemana = Model.DiaSemana switch
    {
        "D" => "Domingo",
        "SF" => "Segunda-feira",
        "TF" => "Terça-feira",
        "QF" => "Quarta-feira",
        "QIF" => "Quinta-feira",
        "SXF" => "Sexta-feira",
        "S" => "Sábado",
        _ => Model.DiaSemana
    };
    var status = Model.StatusDisponibilidade == "D" ? "Disponível" : "Não disponível";
}

<div class="mb-4">
    <a asp-action="Index" asp-route-idPessoa="@Model.IdPessoa" class="text-decoration-none text-secondary font-weight-bold">
        <i class="bi bi-arrow-left"></i> Voltar para a lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bankai-card">
            <div class="text-center mb-4">
                <div class="d-inline-block p-3 rounded-circle bg-light text-warning mb-2 fs-2">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h3 class="font-weight-bold">@diaSemana</h3>
                <span class="badge @(Model.StatusDisponibilidade == "D" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle") px-3 py-2 rounded-pill">
                    @status
                </span>
            </div>

            <div class="bg-light p-4 rounded-3 mb-4 border">
                <div class="row mb-3">
                    <div class="col-sm-5 text-muted small fw-bold">PROFISSIONAL ID</div>
                    <div class="col-sm-7 fw-bold">#@Model.IdPessoa</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 text-muted small fw-bold">HORÁRIO DE INÍCIO</div>
                    <div class="col-sm-7">@Model.HorarioInicio?.ToString(@"hh\:mm")</div>
                </div>
                <div class="row">
                    <div class="col-sm-5 text-muted small fw-bold">HORÁRIO DE TÉRMINO</div>
                    <div class="col-sm-7">@Model.HorarioFim?.ToString(@"hh\:mm")</div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-bankai flex-grow-1 py-2 fw-bold">
                    <i class="bi bi-pencil me-1"></i> Editar
                </a>
                <a asp-action="Index" asp-route-idPessoa="@Model.IdPessoa" class="btn btn-outline-secondary py-2 px-4 rounded-3">Voltar</a>
            </div>
        </div>
    </div>
</div>