@model BankaiWeb.Models.GarantiaViewModel

@{
    ViewData["Title"] = "Editar Chamado de Garantia";
}

<div class="execution-container mt-4" style="grid-template-columns: 1fr 400px;">
    <div class="exec-card">
        <h2 class="fw-bold mb-1">Alterar Chamado #GAR-@Model.Id</h2>
        <p class="text-muted mb-4 small">Atualize a descrição do problema ou o status de atendimento da garantia.</p>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="DataChamado" />

            <div class="form-group mb-3">
                <label asp-for="IdAgendamento" class="form-label fw-bold small text-uppercase">Agendamento Vinculado</label>
                <input asp-for="IdAgendamento" class="form-control" />
                <span asp-validation-for="IdAgendamento" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StatusGarantia" class="form-label fw-bold small text-uppercase">Status do Atendimento</label>
                <select asp-for="StatusGarantia" class="form-select">
                    <option value="S">S - Solicitada</option>
                    <option value="A">A - Agendado</option>
                    <option value="R">R - Em Rota</option>
                    <option value="E">E - Em Execução</option>
                    <option value="C">C - Concluído</option>
                </select>
                <span asp-validation-for="StatusGarantia" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descricao" class="form-label fw-bold small text-uppercase">Descrição do Problema</label>
                <textarea asp-for="Descricao" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-bankai">Salvar Alterações</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>

    <div class="sidebar-card">
        <h6 class="info-title mb-3">Legenda dos Status</h6>
        <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
            <li><span class="badge bg-warning text-dark">S</span> Solicitada pelo cliente</li>
            <li><span class="badge bg-info text-white">A</span> Retorno Agendado</li>
            <li><span class="badge bg-primary">R</span> Técnico em Rota</li>
            <li><span class="badge bg-secondary">E</span> Em Execução do Reparo</li>
            <li><span class="badge bg-success">C</span> Garantia Concluída</li>
        </ul>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}