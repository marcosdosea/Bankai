@model BankaiWeb.Models.PagamentoViewModel

@{
    ViewData["Title"] = "Realizar Pagamento - Bankai";
}

<!-- Cabeçalho idêntico ao protótipo -->
<div class="payment-topbar d-flex justify-content-between align-items-center">
    <span class="logo">BANKAI</span>
    <span class="payment-security-badge">
        🛡 Ambiente de Pagamento Seguro
    </span>
</div>

<div class="payment-wrapper">
    <!-- Fluxo Alternativo CSU06: Botão Voltar para Tela_007 -->
    <div class="mb-3">
        <a asp-controller="Servico" asp-action="Index" class="btn-back small">
            ← Voltar
        </a>
    </div>

    <!-- Exibição das mensagens de Fluxo de Exceção do CSU06 -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger rounded-3 small fw-semibold mb-4"></div>
    }

    <form asp-action="RealizarPagamento" method="post">
        @Html.AntiForgeryToken()

        <!-- Campos ocultos para manter o vínculo com o Agendamento e dados do Resumo -->
        <input type="hidden" asp-for="CodigoAgendamento" />
        <input type="hidden" asp-for="ServicoAdquirido" />
        <input type="hidden" asp-for="NomeProfissional" />
        <input type="hidden" asp-for="ValorTransacao" />
        <input type="hidden" asp-for="StatusPagamento" />
        <input type="hidden" asp-for="FormaPagamento" id="FormaPagamentoInput" />

        <div class="payment-container">
            <!-- COLUNA ESQUERDA: Forma de Pagamento -->
            <div class="payment-card">
                <h5 class="payment-card-title">
                    <span class="icon-accent">💳</span> Forma de Pagamento
                </h5>

                <!-- Abas de seleção (Pix vs Cartão de Crédito) -->
                <div class="payment-methods-grid">
                    <button type="button" id="btnAbaPix" class="btn-payment-method @(Model.FormaPagamento == "P" ? "active" : "")" onclick="selecionarFormaPagamento('P')">
                        ▣ Pagar com Pix
                    </button>
                    <button type="button" id="btnAbaCartao" class="btn-payment-method @(Model.FormaPagamento == "CC" ? "active" : "")" onclick="selecionarFormaPagamento('CC')">
                        💳 Cartão de Crédito
                    </button>
                </div>

                <!-- FLUXO ALTERNATIVO PIX: QR Code e Copia e Cola -->
                <div id="secaoPix" style="display: @(Model.FormaPagamento == "P" ? "block" : "none");">
                    <div class="pix-box">
                        <p class="fw-semibold text-dark mb-3">Escaneie o QR Code abaixo no app do seu banco</p>
                        <div class="pix-qr-frame">
                            <svg width="150" height="150" viewBox="0 0 100 100" fill="#1c1e21">
                                <rect x="10" y="10" width="25" height="25" fill="none" stroke="#1c1e21" stroke-width="5" />
                                <rect x="17" y="17" width="11" height="11" />
                                <rect x="65" y="10" width="25" height="25" fill="none" stroke="#1c1e21" stroke-width="5" />
                                <rect x="72" y="17" width="11" height="11" />
                                <rect x="10" y="65" width="25" height="25" fill="none" stroke="#1c1e21" stroke-width="5" />
                                <rect x="17" y="72" width="11" height="11" />
                                <rect x="45" y="15" width="10" height="10" />
                                <rect x="45" y="35" width="10" height="20" />
                                <rect x="15" y="45" width="20" height="10" />
                                <rect x="65" y="45" width="25" height="10" />
                                <rect x="45" y="65" width="15" height="25" />
                                <rect x="70" y="70" width="20" height="20" />
                            </svg>
                        </div>

                        <div class="text-start">
                            <label class="payment-label">Pix Copia e Cola</label>
                            <div class="input-group">
                                <input type="text" id="codigoPixCopiaCola" class="form-control payment-input small" readonly
                                       value="00020126580014BR.GOV.BCB.PIX0136bankai-pagamentos@bankai.com.br5204000053039865802BR" />
                                <button type="button" class="btn btn-outline-secondary fw-semibold" onclick="copiarPix()">
                                    Copiar
                                </button>
                            </div>
                            <small id="feedbackCopia" class="text-success fw-semibold d-none mt-1">
                                Código Pix copiado!
                            </small>
                        </div>
                    </div>
                </div>

                <!-- FLUXO ALTERNATIVO CARTÃO DE CRÉDITO: Número, Nome, Validade e CVV -->
                <div id="secaoCartao" style="display: @(Model.FormaPagamento == "CC" ? "block" : "none");">
                    <div class="mb-3">
                        <label asp-for="NumeroCartao" class="payment-label">NÚMERO DO CARTÃO</label>
                        <input asp-for="NumeroCartao" class="payment-input" placeholder="0000 0000 0000 0000" maxlength="19" />
                        <span asp-validation-for="NumeroCartao" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NomeTitularCartao" class="payment-label">NOME IMPRESSO NO CARTÃO</label>
                        <input asp-for="NomeTitularCartao" class="payment-input" placeholder="EX: CARLOS A ALBUQUERQUE" />
                        <span asp-validation-for="NomeTitularCartao" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="ValidadeCartao" class="payment-label">VALIDADE</label>
                            <input asp-for="ValidadeCartao" class="payment-input" placeholder="MM/AA" maxlength="5" />
                            <span asp-validation-for="ValidadeCartao" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="CvvCartao" class="payment-label">CVC (CÓDIGO DE SEGURANÇA)</label>
                            <input asp-for="CvvCartao" class="payment-input" placeholder="123" maxlength="4" />
                            <span asp-validation-for="CvvCartao" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUNA DIREITA: Resumo do Pedido -->
            <div class="payment-card">
                <p class="summary-section-title">RESUMO DO PEDIDO</p>

                <div class="summary-row">
                    <span class="summary-label">Ordem Vincular:</span>
                    <span class="summary-value">@Model.OrdemVincular</span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Serviço Adquirido:</span>
                    <span class="summary-value">@Model.ServicoAdquirido</span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Profissional:</span>
                    <span class="summary-value-accent">@Model.NomeProfissional</span>
                </div>

                <div class="summary-divider"></div>

                <div class="summary-total-row">
                    <span class="total-label">Total a Reter:</span>
                    <span class="total-value">@Model.ValorTransacao.ToString("C")</span>
                </div>

                <button type="submit" class="btn-confirm-payment">
                    🔒 Realizar Pagamento
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function selecionarFormaPagamento(forma) {
            document.getElementById('FormaPagamentoInput').value = forma;

            const btnPix = document.getElementById('btnAbaPix');
            const btnCartao = document.getElementById('btnAbaCartao');
            const secaoPix = document.getElementById('secaoPix');
            const secaoCartao = document.getElementById('secaoCartao');

            if (forma === 'P') {
                btnPix.classList.add('active');
                btnCartao.classList.remove('active');
                secaoPix.style.display = 'block';
                secaoCartao.style.display = 'none';
            } else {
                btnCartao.classList.add('active');
                btnPix.classList.remove('active');
                secaoCartao.style.display = 'block';
                secaoPix.style.display = 'none';
            }
        }

        function copiarPix() {
            const inputPix = document.getElementById('codigoPixCopiaCola');
            inputPix.select();
            navigator.clipboard.writeText(inputPix.value);
            document.getElementById('feedbackCopia').classList.remove('d-none');
        }
    </script>
}