@model IEnumerable<BankaiWeb.Models.PagamentoViewModel>

@{
    ViewData["Title"] = "Histórico de Pagamentos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Pagamentos Registrados</h3>
            <p class="text-muted small mb-0">Acompanhe as transações vinculadas aos agendamentos</p>
        </div>
        <a asp-action="RealizarPagamento" class="btn text-white fw-semibold px-4" style="background-color: #D97706;">
            + Realizar Pagamento
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Código</th>
                            <th>Ordem Vincular</th>
                            <th>Forma de Pagamento</th>
                            <th>Status</th>
                            <th>Valor</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.Codigo</td>
                                <td>@item.OrdemVincular</td>
                                <td>@(item.FormaPagamento == "P" ? "Pix" : "Cartão de Crédito")</td>
                                <td>
                                    @if (item.StatusPagamento == "A")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Aprovado</span>
                                    }
                                    else if (item.StatusPagamento == "R")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Recusado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-3">Aguardando</span>
                                    }
                                </td>
                                <td class="fw-semibold">@item.ValorTransacao.ToString("C")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-secondary">Comprovante</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>