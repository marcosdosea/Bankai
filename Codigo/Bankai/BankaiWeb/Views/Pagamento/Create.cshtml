@model BankaiWeb.Models.PagamentoViewModel

@{
    ViewData["Title"] = "Cadastrar Pagamento";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-secondary fw-bold">
        <i class="bi bi-arrow-left"></i> Voltar para a lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bankai-card">
            <h3 class="fw-bold mb-1 text-dark">Cadastrar Pagamento</h3>
            <p class="text-muted small mb-4">Registro manual de transação financeira</p>

            <form asp-action="Create">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CodigoAgendamento" class="form-label fw-semibold"></label>
                    <input asp-for="CodigoAgendamento" class="form-control" />
                    <span asp-validation-for="CodigoAgendamento" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FormaPagamento" class="form-label fw-semibold"></label>
                    <select asp-for="FormaPagamento" class="form-select">
                        <option value="PIX">PIX</option>
                        <option value="Cartão de Crédito">Cartão de Crédito</option>
                    </select>
                    <span asp-validation-for="FormaPagamento" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StatusPagamento" class="form-label fw-semibold"></label>
                    <select asp-for="StatusPagamento" class="form-select">
                        <option value="AP">AP - Aguardando Processamento</option>
                        <option value="P">P - Processando</option>
                        <option value="A">A - Aprovado</option>
                        <option value="R">R - Recusado</option>
                        <option value="C">C - Cancelado</option>
                    </select>
                    <span asp-validation-for="StatusPagamento" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ValorTransacao" class="form-label fw-semibold"></label>
                    <input asp-for="ValorTransacao" class="form-control" />
                    <span asp-validation-for="ValorTransacao" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-bankai flex-grow-1">Salvar Pagamento</button>
                    <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}